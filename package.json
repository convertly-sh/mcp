{
  "name": "@convertly-sh/mcp",
  "version": "0.3.5",
  "description": "Local MCP server for Convertly media workflows over approved filesystem folders.",
  "homepage": "https://convertly.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/convertly-sh/mcp.git"
  },
  "bugs": {
    "url": "https://github.com/convertly-sh/mcp/issues"
  },
  "type": "module",
  "bin": {
    "convertly-mcp": "bin/convertly-mcp.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
