    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/tar": "^6.1.13",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public"
  }
